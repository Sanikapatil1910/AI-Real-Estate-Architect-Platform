DATABASE_URL=sqlite:///./backend/data/realestate.db
SECRET_KEY=replace-with-a-long-random-secret-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional (free): lets the "Describe your house" box understand free-form text with Google Gemini.
# Get a key at https://aistudio.google.com/apikey - without it the built-in rule-based reader is used.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash
